{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ATC trainer scenario (draft v0.2; documentation, the loader checks, D-408)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "validation", "airfield", "initialState", "generators", "initialStep", "steps", "pttRules", "completion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "comment": { "type": "string" },
    "id": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
    "name": { "type": "string" },
    "category": { "enum": ["departure", "arrival", "ground", "landing", "go-around", "emergency", "rcf", "abnormal"] },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "difficulty": { "enum": ["basic", "intermediate", "advanced"] },
    "validation": { "$ref": "#/definitions/validation" },
    "airfield": { "type": "string", "description": "id of an airfield file" },
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": { "phase": { "type": "string" } }
    },
    "generators": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pool"],
        "properties": {
          "pool": { "enum": ["callsigns", "aircraftTypes", "runways", "taxiways"] },
          "mustServe": { "type": "string", "description": "name of another generated parameter, e.g. runway" }
        }
      }
    },
    "initialStep": { "type": "string" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } },
    "unexpectedEvents": { "type": "array", "items": { "$ref": "#/definitions/unexpectedEvent" } },
    "pttRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pressDuringPilot"],
      "properties": {
        "pressDuringPilot": { "enum": ["interrupt", "block", "queue"] },
        "interruptedReply": { "enum": ["repeat", "discard"] }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finalSteps"],
      "properties": {
        "finalSteps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "maxDurationSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "definitions": {
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["placeholder", "validated"] },
        "sopRef": { "type": "string" },
        "validatedBy": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "validated" } } },
      "then": { "required": ["status", "sopRef", "validatedBy"] }
    },
    "outcome": { "enum": ["CORRECT", "MISSING_INFO", "AMBIGUOUS", "UNINTELLIGIBLE", "WRONG_CALLSIGN", "UNSAFE", "CONFLICT", "UNEXPECTED", "INCORRECT", "TIMEOUT"] },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["say", "silent"] },
        "reply": { "type": "string", "description": "id in data/phraseology/replies (D-402)" },
        "withField": { "type": "object", "additionalProperties": { "type": "string" }, "description": "CORRECT only: optional field that was given -> reply id said instead (O-3)" }
      },
      "if": { "properties": { "action": { "const": "say" } } },
      "then": { "required": ["action", "reply"] }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "op", "right"],
      "properties": {
        "left": { "type": "string" },
        "op": { "enum": ["eq", "ne", "lt", "le", "gt", "ge"] },
        "right": { "type": ["string", "number", "boolean"] }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "required"],
      "properties": {
        "intent": { "type": "string" },
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "maxItems": 1, "items": { "type": "string" }, "description": "accepted if given (the intent's parse.optional); CORRECT needs a withField reply for it" },
        "mustMatch": { "type": "object", "additionalProperties": { "type": "string" }, "description": "field -> {parameter} it must equal" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "phase", "expects", "responses", "transitions"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "phase": { "type": "string" },
        "expects": { "type": "array", "items": { "$ref": "#/definitions/expectation" } },
        "safetyRules": { "type": "array", "items": { "type": "string" } },
        "onEnter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["say", "delaySeconds"],
          "properties": { "say": { "type": "string", "description": "reply id" }, "delaySeconds": { "type": "number", "minimum": 0 } }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "maxPilotCalls": { "type": "integer", "minimum": 0 },
        "maxSayAgain": { "type": "integer", "minimum": 1 },
        "responses": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/outcome" },
          "additionalProperties": { "$ref": "#/definitions/response" }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["on", "to"],
            "properties": {
              "on": { "$ref": "#/definitions/outcome" },
              "to": { "type": "string" },
              "errorBranch": { "type": "boolean", "description": "must be true when 'on' is not CORRECT; 'on' is never TIMEOUT (semantic checks)" },
              "guard": { "$ref": "#/definitions/guard" }
            }
          }
        }
      }
    },
    "unexpectedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "atStep", "say", "to"],
      "properties": {
        "id": { "type": "string" },
        "atStep": { "type": "string" },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "say": { "$ref": "#/definitions/response" },
        "to": { "type": "string" }
      }
    }
  }
}
