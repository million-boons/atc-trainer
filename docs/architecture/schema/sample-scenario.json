{
  "schemaVersion": 1,
  "id": "SAMPLE-GND-01",
  "name": "PLACEHOLDER ground taxi sample",
  "category": "ground",
  "objectives": ["PLACEHOLDER - validate against approved SOP"],
  "difficulty": "basic",
  "validation": { "status": "placeholder" },
  "airfield": "SAMPLE-AF",
  "initialState": { "phase": "parked" },
  "generators": {
    "runway": { "pool": "runways" },
    "taxiway": { "pool": "taxiways", "mustServe": "runway" },
    "aircraftType": { "pool": "aircraftTypes" },
    "callsign": { "pool": "callsigns", "mustServe": "aircraftType" }
  },
  "initialStep": "TAXI",
  "steps": [
    {
      "id": "TAXI",
      "label": "PLACEHOLDER taxi instruction",
      "phase": "taxi",
      "expects": [
        {
          "intent": "TAXI_INSTRUCTION",
          "required": ["callsign", "taxiway", "runway"],
          "mustMatch": { "callsign": "{callsign}", "taxiway": "{taxiway}", "runway": "{runway}" }
        }
      ],
      "safetyRules": [],
      "timeoutSeconds": 30,
      "maxPilotCalls": 2,
      "maxSayAgain": 3,
      "responses": {
        "CORRECT": { "action": "say", "template": "PLACEHOLDER readback via {taxiway} runway {runway}, {callsign}", "validation": { "status": "placeholder" } },
        "MISSING_INFO": { "action": "say", "template": "PLACEHOLDER request missing item, {callsign}", "validation": { "status": "placeholder" } },
        "AMBIGUOUS": { "action": "say", "template": "PLACEHOLDER say again, {callsign}", "validation": { "status": "placeholder" } },
        "UNINTELLIGIBLE": { "action": "say", "template": "PLACEHOLDER say again, {callsign}", "validation": { "status": "placeholder" } },
        "INCORRECT": { "action": "say", "template": "PLACEHOLDER query instruction, {callsign}", "validation": { "status": "placeholder" } },
        "WRONG_CALLSIGN": { "action": "silent" },
        "TIMEOUT": { "action": "say", "template": "PLACEHOLDER pilot call, {callsign}", "validation": { "status": "placeholder" } }
      },
      "transitions": [{ "on": "CORRECT", "to": "DONE" }]
    },
    { "id": "DONE", "label": "Complete", "phase": "complete", "expects": [], "responses": {}, "transitions": [] }
  ],
  "pttRules": { "pressDuringPilot": "interrupt", "interruptedReply": "repeat" },
  "completion": { "finalSteps": ["DONE"], "maxDurationSeconds": 600 }
}
