# Lets the user at the screen use the PTT device without root, surviving replug and reboot.
# Gives a stable name, since the event number changes. Must sort before 73-seat-late.rules.
# Never matches a keyboard: reading a keyboard would expose everything that is typed.
ACTION=="remove", GOTO="atc_ptt_end"
SUBSYSTEM!="input", GOTO="atc_ptt_end"
KERNEL!="event*", GOTO="atc_ptt_end"
ENV{ID_INPUT_KEYBOARD}=="1", GOTO="atc_ptt_end"

# The foot pedal, and nothing else (G1-P, 2026-11-27): Microchip "Preon", 04d8:0055, mouse-type, BTN_RIGHT held while
# pressed. Only a mouse-type device of these numbers matches. uaccess lets the user at the screen read it; the app opens
# it read-only. LIBINPUT_IGNORE_DEVICE stops the pedal from right-clicking on the desktop.
ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="0055", ENV{ID_INPUT_MOUSE}=="1", TAG+="uaccess", SYMLINK+="input/atc-pedal", ENV{LIBINPUT_IGNORE_DEVICE}="1"
# The mouse stand-in has no rule any more: as a fallback it needs setfacl after each replug, as before.

LABEL="atc_ptt_end"
