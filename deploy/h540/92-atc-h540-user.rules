# On plug-in, start the per-user service that sets AGC and capture level.
# At login the service starts by itself (WantedBy=default.target).
ACTION=="add", SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0a37", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="atc-h540.service"
