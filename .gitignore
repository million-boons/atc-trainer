# No audio or model files in git (D-31, D-44).
# Leading / = project root only: "bench/" alone would also hide src/bench and data/bench.
/build/
/models/
/recordings/
/bench/
/scratch/
*.wav
*.flac
*.bin
*.gguf
*.fst
*.mdl
# Engines and models; rebuilt by tools/fetch_stt.sh from pinned checksums.
/third_party
# Local to one machine
.claude/settings.local.json
__pycache__/
*.part
# One working copy per session (D-304)
/.worktrees/
# Never in git, even if copied into a working copy by mistake (D-343): audio, people data, logs, keys.
*.mp3
*.ogg
people.json
instructor.pin
setup.json
/exercise-audio/
/voices/
/voices-pending/
/exercises/
